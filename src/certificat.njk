<p id="certificat-blabla">
    Ce certificat est valable à vie et certifié par la blockchain.<br />
    100% numérique et infalsifiable, bilingue français/franglais.<br />
    Il peut être utilisé en lieu et place d'un CV.
</p>

<form onsubmit="submitCertif(event)">
    <div id="certificat-wrap">
        <div id="certificat">
            <div class="certificat-header">
                <div class="palme"></div>
                <!-- https://svgsilh.com/image/2109235.html -->
                <div>
                    <h1>
                        <div style="font-weight: lighter">
                            Certificat de réussite
                        </div>
                        <div id="ilar">
                            International Institute of La&nbsp;RACHE
                        </div>
                    </h1>
                    <div>100% de réussite (ou presque) pour</div>
                    <label for="certificat-name" class="sr-only">Prénom et nom</label>
                    <input
                        type="text"
                        id="certificat-name"
                        name="name"
                        spellcheck="false"
                        placeholder="Prénom NOM"
                        required
                        aria-label="Prénom et nom pour le certificat"
                    />
                </div>

                <div class="palme"></div>
            </div>

            <blockquote>
                Qui est capable de mener à bien n'importe quel projet, même à
                l'arrache.
            </blockquote>
            <p>
                Formé(e) à la cafèt’, le&nbsp;<span id="certificat-date"
                    >../../....</span
                >
            </p>

            <div class="certificat-footer">
                <div>
                    <div>Le Président</div>
                    <strong>Gilles METODA</strong>
                </div>
                <div class="badge">
                    <div class="badge-img"></div>
                    <span class="badge-label">La RACHE</span>
                </div>
                <div>
                    <div>
                        <div>Chargé<span id="ee">e</span> de Formation</div>
                        <strong>
                            L<span id="ea">a</span>
                            stagiaire
                        </strong>
                    </div>
                    <div class="certificat-link">
                        <a href="https://www.la-rache.com">la-rache.com</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <p id="certificat-actions">
        <button type="button" onclick="resetName()">
            <span class="icon">🖊️</span> Modifier
        </button>
        &nbsp;
        <button type="button" id="certificat-actions-share" onclick="share()">
            <span class="icon">📤</span> Partager
        </button>
        <button type="button" id="certificat-actions-copy" onclick="copy()">
            <span class="icon">🔗</span> Copier le lien
        </button>
        &nbsp;
        <button type="button" onclick="download()">
            <span class="icon">📸</span> Enregistrer
        </button>
        <button type="submit" class="sr-only">Valider le certificat</button>
    </p>
</form>
<link rel="stylesheet" href="css/certificat.css" />
<script src="js/vendor/dom-to-image.min.js" defer></script>
<script src="js/certificat.js" defer></script>
