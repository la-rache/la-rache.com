    <script>
      // Burger menu aria-expanded toggle
      (function() {
        var checkbox = document.getElementById('burgermenu-checkbox');
        var label = document.querySelector('label[for="burgermenu-checkbox"]');
        if (checkbox && label) {
          checkbox.addEventListener('change', function() {
            label.setAttribute('aria-expanded', this.checked ? 'true' : 'false');
          });
        }
      })();

