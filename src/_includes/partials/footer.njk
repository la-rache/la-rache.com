    <script>
      // Burger menu accessibility
      (function() {
        var checkbox = document.getElementById('burgermenu-checkbox');
        var label = document.querySelector('label[for="burgermenu-checkbox"]');

        if (checkbox && label) {
          // Toggle aria-expanded when menu opens/closes
          checkbox.addEventListener('change', function() {
            label.setAttribute('aria-expanded', this.checked ? 'true' : 'false');
          });

          // Close menu with Escape key
          document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && checkbox.checked) {
              checkbox.checked = false;
              label.setAttribute('aria-expanded', 'false');
              label.focus(); // Return focus to toggle button
            }
          });

          // Support Enter/Space on label (for role="button")
          label.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              checkbox.checked = !checkbox.checked;
              label.setAttribute('aria-expanded', checkbox.checked ? 'true' : 'false');
            }
          });
        }
      })();

      // Google Analytics
      (function(b,o,i,l,e,r){b.GoogleAnalyticsObject=l;b[l]||(b[l]=
      function(){(b[l].q=b[l].q||[]).push(arguments)});b[l].l=+new Date;
      e=o.createElement(i);r=o.getElementsByTagName(i)[0];
      e.src='https://www.google-analytics.com/analytics.js';
      r.parentNode.insertBefore(e,r)}(window,document,'script','ga'));
      ga('create','UA-72323921-1','auto');ga('send','pageview');
    </script>
